{
  "name": "instagram-runtime-loader",
  "version": "1.0.0",
  "private": true,
  "description": "Serves a pinned, validated snapshot of the original Instagram web client with a local compatibility backend; never fetches the client at runtime.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "validate": "node scripts/validate-inventory.js",
    "sweep": "node scripts/sweep-pages.js",
    "sweep:retry": "RETRY_INCONCLUSIVE=1 BETWEEN_MS=20000 node scripts/sweep-pages.js",
    "verify": "node scripts/verify.js",
    "verify:browser": "node scripts/browser-check.js",
    "test": "node --test --test-timeout=90000 test/*.test.js",
    "test:backend": "node --test --test-timeout=90000 test/migrations.test.js test/auth.test.js test/api.test.js test/crypto.test.js test/visibility.test.js",
    "test:loader": "node --test --test-timeout=90000 test/loader.test.js test/viewer-isolation.test.js test/upstream-leak.test.js test/shell.test.js test/pinned-client.test.js test/document-render.test.js test/signed-in-route.test.js",
    "test:clone": "node --test --test-timeout=90000 test/clone.test.js test/auth-lifecycle.test.js test/password-encryption.test.js",
    "verify:browser-auth": "node scripts/browser-auth-check.js",
    "verify:browser-loading": "node scripts/browser-loading-check.js",
    "verify:genuine-signup": "node scripts/genuine-signup-check.js",
    "verify:genuine-login": "node scripts/genuine-login-check.js",
    "verify:genuine-feed": "node scripts/genuine-feed-check.js",
    "verify:genuine-profile": "node scripts/genuine-profile-check.js",
    "verify:genuine-create": "node scripts/genuine-create-check.js",
    "verify:genuine-engage": "node scripts/genuine-engage-check.js",
    "audit:routes": "node scripts/route-audit.js",
    "cache:status": "node scripts/asset-cache.js status",
    "cache:warm": "node scripts/asset-cache.js warm",
    "client:acquire": "node scripts/client-acquire.js",
    "client:build": "node scripts/client-snapshot.js build",
    "client:verify": "node scripts/client-snapshot.js verify",
    "client:activate": "node scripts/client-snapshot.js activate",
    "client:rollback": "node scripts/client-snapshot.js rollback",
    "client:status": "node scripts/client-snapshot.js status",
    "client:setup": "node scripts/client-bundle.js setup",
    "client:bundle": "node scripts/client-bundle.js export",
    "client:bundle-check": "node scripts/client-bundle.js check",
    "client:fetch": "node scripts/client-bundle.js fetch",
    "client:pack": "node scripts/client-bundle.js pack",
    "verify:pinned-restart": "node scripts/pinned-restart-check.js",
    "pages": "node scripts/page-coverage.js",
    "journey:deeplinks": "node scripts/deeplink-journey.js",
    "check:reels-layout": "node scripts/reels-layout.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "blakejs": "^1.2.1",
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "tweetnacl": "^1.0.3"
  }
}
