# Instagram Runtime Loader: every environment variable the server and setup
# read, with their defaults. Nothing here is a secret and none is required:
# with no environment at all the server runs on 0.0.0.0:12000 from the pinned
# client in .cache/client and the database in .data/.
#
# The server does not load this file itself. To use it:
#   cp .env.example .env      # edit as needed
#   node --env-file=.env src/server.js

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=12000
# Log each request (1/0).
VERBOSE=1
# Browser cache lifetime of pinned static assets, in milliseconds.
CACHE_TTL_MS=300000

# --- Pinned client ----------------------------------------------------------
# The snapshot store the server serves from (npm run client:setup installs it).
CLIENT_DIR=.cache/client
# Serve this snapshot instead of the store's active one (to check a candidate).
# CLIENT_SNAPSHOT_ID=
# Where client:setup downloads the pinned client artifact from when client/blobs/
# is absent, instead of the URLs in client/bundle.json: an https URL or a local
# file path. Its sha256 must equal the one pinned in client/bundle.json.
# CLIENT_ARTIFACT=
# Hosts whose assets the pinned client references (served from the snapshot).
ALLOWED_ASSET_HOSTS=static.cdninstagram.com,www.instagram.com,instagram.com,scontent.cdninstagram.com
# Serve signed-in visitors the signed-in route document (0 = anonymous document for everyone).
SHELL_SIGNED_IN_HOME=1
# Drop the documents' prefetch hints (1/0).
SHELL_DROP_PREFETCHES=0

# --- Backend (our own accounts, posts, messages) ----------------------------
BACKEND_ENABLED=1
BACKEND_PREFIX=/__backend
BACKEND_DB=.data/backend.db
# Uploaded media; defaults to the database's directory.
# CLONE_DATA_DIR=.data
BACKEND_VERBOSE=1
# Cookie names the genuine client understands. Values are issued by this server.
BACKEND_COOKIE=sessionid
BACKEND_CSRF_COOKIE=csrftoken
BACKEND_VIEWER_COOKIE=ds_user_id
# Set to 1 when served over HTTPS (adds Secure to the cookies).
BACKEND_SECURE_COOKIES=0
# Set to 1 behind a reverse proxy, so the client address comes from X-Forwarded-For.
TRUST_PROXY=0
SESSION_TTL_MS=604800000
SESSION_ROTATE_MS=3600000
# Password hashing (scrypt).
SCRYPT_COST=32768
SCRYPT_BLOCK_SIZE=8
SCRYPT_PARALLELISM=1
SCRYPT_KEYLEN=32
# Rate limits: requests per window per client, and for login/signup endpoints.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Operator acquisition only (npm run client:acquire) ---------------------
# The server never contacts Instagram; these only affect the explicit
# acquisition command that records a new snapshot.
UPSTREAM_ORIGIN=https://www.instagram.com
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=3
RETRY_BASE_MS=1000
RETRY_MAX_MS=15000
# Pause after a 429 when the origin gives no Retry-After, in milliseconds.
# UPSTREAM_COOLDOWN_MS=
# 1 makes any acquisition request fail instead of contacting the origin.
LOADER_OFFLINE=0
# USER_AGENT=
